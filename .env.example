APP_NAME=ARS
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# DDEV: http://ars.ddev.site:8080. Produção: http://172.31.20.60/ars (ver deploy/env.producao.example).
APP_URL=http://ars.ddev.site:8080
# Só em subpasta (produção): ASSET_URL=/ars e SESSION_PATH=/ars.
# ASSET_URL=
APP_TIMEZONE=America/Recife
APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en_CA
APP_FAKER_LOCALE=pt_BR

# Janela em que a réplica do NEO está sendo atualizada (minutos de cada hora).
APP_NEO_WAIT_START_MINUTE=0
APP_NEO_WAIT_END_MINUTE=3
APP_NEO_QUERY_LOG=false
APP_NEO_SLOW_QUERY_MS=1000

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_PATH=/

# Banco da ARS (DDEV: host db, banco/usuário/senha db).
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=db
DB_USERNAME=db
DB_PASSWORD=db
DB_CHARSET=utf8mb4

# NEO (SQL Server, somente leitura), driver ODBC 18.
# O SQL Server usa certificado autoassinado: TRUST_SERVER_CERTIFICATE=true (a conexão segue criptografada).
SQLSRV_DB_HOST=
SQLSRV_DB_PORT=1433
SQLSRV_DB_DATABASE=Neo_Juridico_replica
SQLSRV_DB_USERNAME=
SQLSRV_DB_PASSWORD=
SQLSRV_DB_CHARSET=UTF-8
SQLSRV_DB_TRUST_SERVER_CERTIFICATE=true

AUTH_CASE_SENSITIVE=false
AUTH_VALIDATE_ALWAYS=true
AUTH_USER_TABLE=usuarios

MAIL_MAILER=log

# Login único (BVAcesso). ID e segredo: BVAcesso → Administração → Sistemas → ARS.
# Vazio = só o login próprio. BVACESSO_LOCAL_LOGIN=false manda a tela de login direto para o BVAcesso.
BVACESSO_URL=
BVACESSO_CLIENT_ID=
BVACESSO_CLIENT_SECRET=
BVACESSO_LOCAL_LOGIN=true
BVACESSO_CHECK_MINUTES=5

# Botão "Reportar bug" (widget do BVTarefas). Vazio = desligado.
# Token: BVTarefas → Configurações do projeto da ARS → Widget de bugs.
# DDEV: BUG_REPORTER_SCRIPT=http://bvtarefas.ddev.site:8080/widget/bug-reporter.js
BUG_REPORTER_SCRIPT=
BUG_REPORTER_TOKEN=
