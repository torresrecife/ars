<IfModule mod_rewrite.c>
    RewriteEngine On

    RewriteCond %{THE_REQUEST} \s/+(.*/)?login\.php[\s?] [NC]
    RewriteRule ^login\.php$ /ars2/login [R=301,L,QSA]
    RewriteCond %{THE_REQUEST} \s/+(.*/)?index\.php[\s?] [NC]
    RewriteRule ^index\.php$ /ars2/index [R=301,L,QSA]
    RewriteRule ^inc/ajax_andamento\.php$ ajax/andamentos [L,QSA]
    RewriteRule ^inc/ajax_cliente\.php$ ajax/clientes [L,QSA]
    RewriteRule ^inc/ajax_metas\.php$ ajax/metas [L,QSA]
    RewriteRule ^inc/ajax_select\.php$ ajax/select [L,QSA]
    RewriteRule ^inc/ajax_sem\.php$ ajax/semanas [L,QSA]
    RewriteRule ^inc/ajax_setor\.php$ ajax/setores [L,QSA]
    RewriteRule ^inc/ajax_usu\.php$ ajax/usuarios [L,QSA]
    RewriteRule ^ajax_usu\.php$ ajax/usuarios [L,QSA]
    RewriteRule ^ajax_setor\.php$ ajax/setores [L,QSA]
    RewriteRule ^ajax_cliente\.php$ ajax/clientes [L,QSA]
    RewriteRule ^ajax_andamento\.php$ ajax/andamentos [L,QSA]
    RewriteRule ^ajax_metas\.php$ ajax/metas [L,QSA]
    RewriteRule ^ajax_sem\.php$ ajax/semanas [L,QSA]
    RewriteRule ^ajax_regioes\.php$ ajax/regioes [L,QSA]
    RewriteRule ^ajax_select\.php$ ajax/select [L,QSA]
    RewriteRule ^ajax_newpass\.php$ ajax/newpass [L,QSA]
    RewriteRule ^inc/ajax_newpass\.php$ ajax/newpass [L,QSA]
    RewriteRule ^dados_anda\.php$ detalhes/andamentos [L,QSA]
    RewriteRule ^dados_fatur\.php$ detalhes/faturamento [L,QSA]

    RewriteCond %{THE_REQUEST} \s/+(.*/)?***REMOVED***\.php[\s?] [NC]
    RewriteRule ^***REMOVED***\.php$ /ars2/***REMOVED*** [R=301,L,QSA]
    RewriteCond %{THE_REQUEST} \s/+(.*/)?usu\.php[\s?] [NC]
    RewriteRule ^usu\.php$ /ars2/usuarios [R=301,L,QSA]
    RewriteCond %{THE_REQUEST} \s/+(.*/)?clientes\.php[\s?] [NC]
    RewriteRule ^clientes\.php$ /ars2/clientes [R=301,L,QSA]
    RewriteCond %{THE_REQUEST} \s/+(.*/)?andamentos\.php[\s?] [NC]
    RewriteRule ^andamentos\.php$ /ars2/andamentos [R=301,L,QSA]
    RewriteCond %{THE_REQUEST} \s/+(.*/)?metas\.php[\s?] [NC]
    RewriteRule ^metas\.php$ /ars2/metas [R=301,L,QSA]
    RewriteCond %{THE_REQUEST} \s/+(.*/)?semanas\.php[\s?] [NC]
    RewriteRule ^semanas\.php$ /ars2/semanas [R=301,L,QSA]
    RewriteCond %{THE_REQUEST} \s/+(.*/)?regioes\.php[\s?] [NC]
    RewriteRule ^regioes\.php$ /ars2/regioes [R=301,L,QSA]
    RewriteCond %{THE_REQUEST} \s/+(.*/)?setor\.php[\s?] [NC]
    RewriteRule ^setor\.php$ /ars2/setores [R=301,L,QSA]
    RewriteCond %{THE_REQUEST} \s/+(.*/)?carteiras\.php[\s?] [NC]
    RewriteRule ^carteiras\.php$ /ars2/carteiras [R=301,L,QSA]
    RewriteCond %{THE_REQUEST} \s/+(.*/)?painel\.php[\s?] [NC]
    RewriteRule ^painel\.php$ /ars2/painel [R=301,L,QSA]
    RewriteCond %{THE_REQUEST} \s/+(.*/)?producao\.php[\s?] [NC]
    RewriteRule ^producao\.php$ /ars2/producao [R=301,L,QSA]
    RewriteCond %{THE_REQUEST} \s/+(.*/)?relatorio\.php[\s?] [NC]
    RewriteRule ^relatorio\.php$ /ars2/relatorio [R=301,L,QSA]

    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    RewriteRule ^ index.php [L,QSA]
</IfModule>
