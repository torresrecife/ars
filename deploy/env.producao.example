# .env da ARS no EUROPA-HD, em http://172.31.20.60/ars (subpasta do site do Peticao Facil). Copiado para /var/www/ars/.env na instalacao.
# Senhas e chaves so no servidor: os valores "<...>" sao preenchidos la, nunca no Git.
APP_NAME=ARS
APP_ENV=production
# Fica vazio aqui; preenchido por "php artisan key:generate" na instalacao.
APP_KEY=
APP_DEBUG=false
APP_URL=http://172.31.20.60/ars
# Prefixo dos arquivos compilados (lido tambem pelo npm run build) e dos cookies:
# os cookies da ARS nao se misturam com os dos outros sistemas no mesmo endereco.
ASSET_URL=/ars
APP_TIMEZONE=America/Recife
APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en_CA
APP_FAKER_LOCALE=pt_BR
APP_MAINTENANCE_DRIVER=file

APP_NEO_WAIT_START_MINUTE=0
APP_NEO_WAIT_END_MINUTE=3
APP_NEO_QUERY_LOG=false
APP_NEO_SLOW_QUERY_MS=1000

LOG_CHANNEL=daily
LOG_LEVEL=warning
LOG_DEPRECATIONS_CHANNEL=null

# Banco no REIA-HD (MySQL 8.4), usuario aceito so a partir do EUROPA-HD.
DB_CONNECTION=mysql
DB_HOST=172.31.20.62
DB_PORT=3306
DB_DATABASE=ars
DB_USERNAME=ars
DB_PASSWORD=<senha do usuario ars no REIA-HD>
DB_CHARSET=utf8mb4

# NEO (SQL Server, somente leitura), driver ODBC 18 ja instalado para o Peticao Facil.
SQLSRV_DB_HOST=<servidor do NEO>
SQLSRV_DB_PORT=1433
SQLSRV_DB_DATABASE=Neo_Juridico_replica
SQLSRV_DB_USERNAME=<usuario do NEO>
SQLSRV_DB_PASSWORD=<senha do usuario do NEO>
SQLSRV_DB_CHARSET=UTF-8
SQLSRV_DB_TRUST_SERVER_CERTIFICATE=true

AUTH_CASE_SENSITIVE=false
AUTH_VALIDATE_ALWAYS=true
AUTH_USER_TABLE=usuarios

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_PATH=/ars
SESSION_DOMAIN=null

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
MAIL_MAILER=log
